// ═══ دمج الحروف والأرقام ═══
const ALL = { ...LETTERS, ...DIGITS };

// ═══ ترتيب: حرف ← مسار ═══
function getLetter(ch) {
  if (!ch) return null;
  const upper = String(ch).toUpperCase();
  return ALL[upper] || null;
}

function listLetters() {
  return Object.keys(ALL);
}

module.exports = { LETTERS, DIGITS, ALL, getLetter, listLetters };
