# ═══════════════════════════════════════════════════════════
#  تطبيق العرض الشامل — كل ميزات نارمين v2.1
# ═══════════════════════════════════════════════════════════

# ═══ 1) الأيقونة الذكية ═══
ايقونة "ايقونة بنفسجية خلفها لمبة مكتوب عليها حرف N وحرف S"

# ═══ 2) الصلاحيات ═══
صلاحية "انترنت"
صلاحية "إشعارات"
صلاحية "اهتزاز"

# ═══ 3) المكتبات ═══
مكتبة "com.google.code.gson:gson:2.10.1"

# ═══ 4) الدوال ═══
دالة تحقق_من_الاسم(الاسم) {
  اذا طول(الاسم) < 3 {
    ارجع خطأ
  }
  ارجع صحيح
}

دالة حساب_المجموع(أرقام) {
  متغير مجموع = 0
  لكل رقم في أرقام {
    مجموع = مجموع + رقم
  }
  ارجع مجموع
}

دالة رسالة_ترحيب(الاسم) {
  ارجع "أهلاً بك يا " + الاسم + " 👋"
}

# ═══ 5) الشاشة الرئيسية ═══
شاشة "العرض الشامل"
  الشريط_العلوي ( لون "بنفسجي عميق" حجم 70 نص "نارمين v2.1" )

  # ═══ الشريط الجانبي ═══
  شريط_جانب "القائمة الرئيسية"
    كتابة "🏠 الرئيسية"
    كتابة "🎨 عناصر الواجهة"
    كتابة "⚡ التفاعلات"
    كتابة "📊 البيانات"
    كتابة "ℹ️ حول"
  نهاية

  # ═══ القسم 1: الترحيب ═══
  عنوان "مرحباً بك في نارمين"
  كتابة "لغة برمجة عربية تُنتج تطبيقات Android"
  مسافة 16
  فاصل
  مسافة 16

  # ═══ القسم 2: كل عناصر الواجهة ═══
  عنوان "🎨 عناصر الواجهة الكاملة"
  مسافة 8

  كتابة "1) العنوان والكتابة"
  مسافة 8

  كتابة "2) حقل الإدخال"
  حقل "اكتب اسمك هنا" كـ الاسم
  مسافة 8

  كتابة "3) الاختيار والمفتاح"
  اختيار "أوافق على الشروط"
  اختيار "تلقّي الإشعارات"
  مفتاح "تفعيل الوضع الليلي"
  مسافة 8

  كتابة "4) قائمة منسدلة"
  قائمة_منسدلة "اختر مدينتك" كـ المدينة من ["القاهرة"، "الرياض"، "دبي"، "بيروت"]
  مسافة 8

  كتابة "5) منتقي التاريخ والوقت"
  تاريخ "تاريخ ميلادك" كـ الميلاد
  مسافة 4
  وقت "وقت الموعد" كـ الموعد
  مسافة 8

  كتابة "6) شريط التقدم"
  تقدم 75
  مسافة 8

  كتابة "7) الأزرار التفاعلية"
  زر "احفظ" ( لون "بنفسجي" حواف "دايري" العرض "كامل" ) عند_الضغط
    اذا تحقق_من_الاسم(الاسم) {
      تنبيه رسالة_ترحيب(الاسم)
    } والا {
      تنبيه "الاسم قصير جداً"
    }
  نهاية
  مسافة 8

  مسافة 16
  فاصل
  مسافة 16

  # ═══ القسم 3: كل التفاعلات ═══
  عنوان "⚡ التفاعلات"
  مسافة 8

  زر "🔔 تنبيه" ( لون "أزرق" ) عند_الضغط
    تنبيه "هذا تنبيه قصير"
  نهاية

  زر "💬 حوار" ( لون "أخضر" ) عند_الضغط
    حوار "رسالة" "هذا حوار منبثق"
  نهاية

  زر "📢 سنيكر" ( لون "برتقالي" ) عند_الضغط
    سنيكر "هذا شريط سفلي"
  نهاية

  زر "🔗 رابط" ( لون "سماوي" ) عند_الضغط
    رابط "https://github.com/aiwaledtv1900-crypto/narmin"
  نهاية

  زر "📤 شارك" عند_الضغط
    شارك "تعرّف على نارمين — لغة البرمجة العربية!"
  نهاية

  زر "📋 انسخ" عند_الضغط
    انسخ "نارمين v2.1"
  نهاية

  مسافة 16
  فاصل
  مسافة 16

  # ═══ القسم 4: شريط التبويبات ═══
  عنوان "🗂 شريط التبويبات"
  شريط_تبويب ["الكل"، "المفضلة"، "الأخيرة"]
    كتابة "محتوى التبويب المختار"
  نهاية

  مسافة 16
  فاصل
  مسافة 16

  # ═══ القسم 5: القائمة ═══
  عنوان "📋 قائمة المهام"
  محفوظ المهام = []
  حقل "أضف مهمة جديدة..." كـ مهمة_جديدة
  مسافة 8
  زر "➕ أضف" ( لون "بنفسجي" العرض "كامل" ) عند_الضغط
    جرب
      اذا مهمة_جديدة != "" {
        أضف(المهام، مهمة_جديدة)
        تنبيه "أُضيفت: " + مهمة_جديدة
      }
    التقط e
      تنبيه "خطأ: " + e
    نهاية
  نهاية

  مسافة 8
  كتابة "المهام الحالية:"
  قائمة المهام
    بطاقة "مهمة" ( لون "لبني" )
      كتابة العنصر
    نهاية
  نهاية

  مسافة 16
  فاصل
  مسافة 16

  # ═══ القسم 6: رسم بياني ═══
  عنوان "📊 رسم بياني"
  رسم_بياني "أعمدة" [120، 200، 150، 300، 250]، ["يناير"، "فبراير"، "مارس"، "أبريل"، "مايو"]

  مسافة 16
  فاصل
  مسافة 16

  # ═══ القسم 7: الخريطة ═══
  عنوان "🗺 الخريطة"
  خريطة 30.0444، 31.2357، 15

  مسافة 16
  فاصل
  مسافة 16

  # ═══ القسم 8: الوسائط ═══
  عنوان "🎬 الوسائط"
  كتابة "فيديو تعليمي:"
  فيديو "https://example.com/video.mp4"
  مسافة 8
  كتابة "مقطع صوتي:"
  صوت "https://example.com/audio.mp3"

  مسافة 16
  فاصل
  مسافة 16

  # ═══ القسم 9: ويب ═══
  عنوان "🌐 متصفح مدمج"
  ويب "https://narmin.dev"

  مسافة 16
  فاصل
  مسافة 16

  # ═══ القسم 10: منتقيات ═══
  عنوان "🎨 منتقي اللون والتاريخ"
  حوار_تاريخ كـ تاريخ_مختار
  مسافة 8
  حوار_لون كـ لون_مختار

  مسافة 16
  فاصل
  مسافة 16

  # ═══ القسم الأخير: الخاتمة ═══
  عنوان "🎉 النهاية"
  كتابة "شكراً لتجربتك نارمين!"
  كتابة "الإصدار: 2.1.0"
  كتابة "المالك: عصام القاضي"

  مسافة 24

  زر "🚀 إشعار نهائي" ( لون "أحمر" حواف "دايري" العرض "كامل" الطول 56 ) عند_الضغط
    أرسل_تنبيه "نارمين" "شكراً لك على التجربة!"
    سنيكر "تم إرسال الإشعار بنجاح"
  نهاية

  مسافة 16
نهاية

