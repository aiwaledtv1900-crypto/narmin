# ══════════════════════════════════════════════
#   نارمين — عرض حقيقي
# ══════════════════════════════════════════════

اطبع "╔══════════════════════════════════╗"
اطبع "║   نارمين  •  Narmin v0.1.0       ║"
اطبع "╚══════════════════════════════════╝"
اطبع ""

# دالة مساعدة
دالة علامة(شرط) {
  اذا شرط {
    ارجع "✓"
  }
  ارجع "✗"
}

# ─── 1. معلومات النظام ───
متغير م = معلومات()
اطبع "▶ النظام"
اطبع "  المعمارية: " + م.معمارية
اطبع "  Node: " + م.إصدار_node
اطبع "  المعالجات: " + نص(م.المعالجات)
اطبع ""

# ─── 2. حالة أدوات APK ───
اطبع "▶ أدوات APK"
متغير ب = apk_بيئة()
اطبع "  apktool:  " + اسم_الملف(ب.apktool_jar)
اطبع "  java:     " + اسم_الملف(ب.java)
اطبع "  aapt2:    " + اسم_الملف(ب.aapt2)
اطبع "  signer:   " + اسم_الملف(ب.signer_jar)
اطبع "  keystore: " + علامة(موجود(ب.keystore))
اطبع ""

# ─── 3. مساحة DEV ───
اطبع "▶ مساحة DEV"
متغير ن = شغل("du"، ["-sh"، ضم(مسار_الرئيسية()، "DEV")])
اذا ن.نجح {
  اطبع "  " + ن.خرج
} والا {
  اطبع "  تعذّر القياس"
}
اطبع ""

# ─── 4. دالة نارمين مخصصة ───
دالة تنسيق_حجم(بايت) {
  اذا بايت < 1024 { ارجع نص(بايت) + " B" }
  اذا بايت < 1024 * 1024 { ارجع نص(بايت / 1024) + " KB" }
  ارجع نص(بايت / 1024 / 1024) + " MB"
}

اطبع "▶ مثال: تنسيق حجم"
متغير أحجام = [1024، 5000000، 2000000000]
لكل ح في أحجام {
  اطبع "  " + نص(ح) + " بايت  →  " + تنسيق_حجم(ح)
}

# ─── 5. ناقل الأنابيب ───
اطبع ""
اطبع "▶ ناقل الأنابيب |>"
دالة ضعف(س) { ارجع س * 2 }
متغير نتيجة = 21 |> ضعف
اطبع "  21 |> ضعف  →  " + نص(نتيجة)

# ─── 6. مصفوفات + دوال ───
اطبع ""
اطبع "▶ عمليات على مصفوفات"
دالة زوجي(س) { ارجع س % 2 == 0 }
متغير أرقام = مدى(1، 11)
متغير زوجية = أرقام.صفي(زوجي)
اطبع "  الأرقام:  " + نص(أرقام)
اطبع "  الزوجية:  " + نص(زوجية)

اطبع ""
اطبع "═══════════════════════════════════"
اطبع "  تم بنجاح — هذه نارمين"
اطبع "═══════════════════════════════════"
