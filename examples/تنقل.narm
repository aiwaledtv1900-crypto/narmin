شاشة "الرئيسية" {
  عنوان "مرحباً بك"
  كتابة "التطبيق الرئيسي"

  مسافة 16
  زر "اذهب للإعدادات" عند_الضغط {
    انتقل "إعدادات"
  }

  مسافة 8
  زر "تنبيه" عند_الضغط {
    تنبيه "مرحباً من نارمين!"
  }
}

شاشة "إعدادات" {
  عنوان "الإعدادات"

  حالة اسم_المستخدم = "ضيف"
  حقل "اسمك" كـ اسم_المستخدم
  كتابة "مرحباً " + اسم_المستخدم

  مسافة 16
  زر "حوار" عند_الضغط {
    حوار "تأكيد" "هل أنت متأكد؟" عند_الضغط {
      اطبع "تم التأكيد"
    }
  }

  زر "رجوع" عند_الضغط {
    رجوع
  }
}
