#@النمط: كريمي

صلاحية "انترنت"

نص_عنوان "بنفسجي عميق"
نص_عادي "فحمي_فاتح"
زر_رئيسي "بنفسجي عميق"
زر_حذف "احمر"

شاشة "دفتر مذكراتي"
  الشريط_العلوي ( لون "بنفسجي عميق" حجم 70 نص "مذكراتي" )

  محفوظ مذكرات = []

  حقل "اكتب مذكرة جديدة..." كـ مذكرة_جديدة ( لون 'نص_عنوان' حواف "متوسط" العرض "كامل" )

  مسافة 8

  زر "➕ أضف المذكرة" ( لون 'زر_رئيسي' حواف "دايري" العرض "كامل" الطول 56 ) عند_الضغط
    اذا مذكرة_جديدة != "" {
      أضف(مذكرات، مذكرة_جديدة)
    }
  نهاية

  مسافة 16

  كتابة "📚 مذكراتي (" + نص(طول(مذكرات)) + ")" ( لون 'نص_عنوان' )

  مسافة 8

  قائمة مذكرات
    بطاقة "📝 مذكرة" ( لون "لبني" حواف "متوسط" )
      كتابة العنصر ( لون 'نص_عادي' )
      مسافة 8
      زر "🗑 احذف" ( لون 'زر_حذف' حواف "بيضاوي" ) عند_الضغط
        احذف_من(مذكرات، العنصر)
      نهاية
    نهاية
  نهاية

نهاية
