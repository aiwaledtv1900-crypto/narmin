#@النمط: كريمي

شاشة "خصائص"
  الشريط_العلوي ( لون "ذهبي" حجم 70 نص "الخصائص" )

  عنوان "تجربة الخصائص" ( لون "بنفسجي عميق" )

  كتابة "كل عنصر يقبل خصائص" ( لون "ازرق داكن" )

  حقل "اسمك" ( لون "ازرق" حواف "بيضاوي" العرض "كامل" )

  مسافة 8

  زر "زر أحمر دايري" ( لون "احمر" حواف "دايري" العرض "كامل" ) عند_الضغط
    تنبيه "تم"
  نهاية

  زر "زر ذهبي مربع" ( لون "ذهبي" حواف "مربع" العرض "كامل" ) عند_الضغط
    تنبيه "تم"
  نهاية

  بطاقة "معلومات" ( لون "لبني" حواف "متوسط" )
    كتابة "داخل بطاقة مخصصة"
  نهاية
نهاية
