# مثال 5: الدوال

دالة جمع(ا، ب) {
  ارجع ا + ب
}

دالة ضعف(س) {
  ارجع س * 2
}

دالة مربع(س) {
  ارجع س * س
}

اطبع "3 + 4 = " + نص(جمع(3، 4))
اطبع "ضعف 21 = " + نص(ضعف(21))
اطبع "مربع 5 = " + نص(مربع(5))

# دالة مركبة
دالة متوسط(أرقام) {
  متغير مجموع = 0
  لكل ن في أرقام {
    مجموع = مجموع + ن
  }
  ارجع مجموع / طول(أرقام)
}

اطبع "متوسط [10، 20، 30] = " + نص(متوسط([10، 20، 30]))
