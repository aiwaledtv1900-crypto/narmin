شاشة "نارمين" {
  عنوان "نارمين"
  كتابة "لغة برمجة عربية"
  كتابة "أندرويد: " + build.إصدار
  كتابة "الجهاز: " + build.موديل
  كتابة "الشركة: " + build.مصنّع

  بطاقة "تجربة" {
    كتابة "هذا تطبيق Android كامل"
    كتابة "الكود بنارمين 100%"
    زر "قل مرحباً" عند_الضغط {
      اطبع "مرحباً من نارمين!"
    }
  }
}
