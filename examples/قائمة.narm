شاشة "مهامي" {
  عنوان "قائمة المهام (" + نص(طول(مهام)) + ")"

  محفوظ مهام = []

  حقل "مهمة جديدة" كـ جديدة
  زر "أضف" عند_الضغط {
    اذا جديدة != "" {
      أضف(مهام، جديدة)
    }
  }

  مسافة 8

  زر "مسح المكتمل" عند_الضغط {
    استبعد(مهام، دالة(س) {
      ارجع يبدأ_بـ(س، "✓ ")
    })
  }

  مسافة 16

  قائمة مهام {
    تمّ
    كتابة العنصر
    زر "احذف" عند_الضغط {
      احذف_من(مهام، العنصر)
    }
  }
}
