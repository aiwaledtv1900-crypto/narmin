متغير ملف = ضم(
  مسار_الرئيسية(),
  "DEV/apps_building/NarminApp/app/build/outputs/apk/debug/app-debug.apk"
)

اذا ليس موجود(ملف) {
  اطبع "✗ APK غير موجود: " + ملف
  ارجع
}

اطبع "▶ الملف: " + اسم_الملف(ملف)
اطبع "▶ الحجم: " + نص(تفاصيل(ملف).حجم / 1024) + " KB"
اطبع ""

متغير نتيجة = android_ثبّت(ملف)

اذا نتيجة.نجح {
  اطبع "✓ تم التثبيت"
  اطبع نتيجة.خرج
  اطبع ""
  اطبع "▶ تشغيل..."
  متغير تشغيل = android_شغّل("com.narmin.narminapp", ".NarminAppActivity")
  اذا تشغيل.نجح {
    اطبع "✓ يعمل الآن على هاتفك"
  } والا {
    اطبع "خطأ: " + تشغيل.خطأ
  }
} والا {
  اطبع "✗ فشل التثبيت:"
  اطبع نتيجة.خطأ
}
