شاشة "قائمة تسوق" {
  عنوان "تسوقي (" + نص(طول(عناصر)) + ")"

  محفوظ عناصر = []
  محفوظ إجمالي = 0

  حقل "اسم المنتج" كـ منتج
  حقل "السعر" كـ سعر

  زر "أضف للسلة" عند_الضغط {
    اذا منتج != "" {
      أضف(عناصر، منتج + " - " + نسّق(سعر) + " ر")
      إجمالي = إجمالي + سعر
    }
  }

  مسافة 8
  كتابة "الإجمالي: " + نسّق(إجمالي) + " ريال"
  مسافة 16

  زر "مسح الكل" عند_الضغط {
    استبعد(عناصر، دالة(س) { ارجع صحيح })
    إجمالي = 0
  }

  قائمة عناصر {
    كتابة العنصر
    زر "✗" عند_الضغط {
      احذف_من(عناصر، العنصر)
    }
  }
}
