شاشة "تنبيهاتي" {
  عنوان "نظام التنبيهات"

  حقل "العنوان" كـ ع
  حقل "المحتوى" كـ م

  مسافة 16

  زر "🔔 أرسل تنبيهاً" عند_الضغط {
    اذا ع != "" && م != "" {
      أرسل_تنبيه ع م
      سنيكر "أُرسل التنبيه!"
    } والا {
      تنبيه "نقص" "املأ الحقلين"
    }
  }

  مسافة 16
  كتابة "التنبيهات تظهر في شريط الإشعارات"
}
