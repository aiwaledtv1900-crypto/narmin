متغير مسار = ضم(مسار_الرئيسية()، "DEV/apps_building/NarminApp")
اطبع "▶ بناء تطبيق نارمين..."
متغير نتيجة = android_بناء(مسار)
اذا نتيجة.نجح {
  اطبع "✓ نجح: " + نتيجة.apk
} والا {
  اطبع "✗ فشل (كود " + نص(نتيجة.كود) + ")"
  اطبع ""
  اطبع "آخر الخرج:"
  اطبع نتيجة.خرج
  اطبع ""
  اطبع "الأخطاء:"
  اطبع نتيجة.خطأ
}
