شاشة "تفاعل النظام" {
  عنوان "تفاعل مع Android"

  حقل "رقم الهاتف" كـ رقم

  مسافة 8

  زر "🌐 افتح google.com" عند_الضغط {
    رابط "https://google.com"
  }

  زر "📞 اتصل" عند_الضغط {
    اذا رقم != "" {
      اتصل رقم
    }
  }

  زر "📤 شارك التطبيق" عند_الضغط {
    شارك "استخدم نارمين! لغة برمجة عربية"
  }

  زر "📋 انسخ رسالة" عند_الضغط {
    انسخ "مرحباً من نارمين"
  }
}
