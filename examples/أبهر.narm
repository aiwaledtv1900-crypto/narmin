# ═══════════════════════════════════════════════════════════
#   نارمين  •  عرض مُبهر
#   يفحص APK حقيقي، يفكّه، يعدّل نصاً، يعيد بناءه، ويوقّعه
# ═══════════════════════════════════════════════════════════

اطبع ""
اطبع "╔══════════════════════════════════════════════════╗"
اطبع "║        نارمين  •  Narmin v0.1.0                  ║"
اطبع "║        عرض حقيقي على APK فعلي                    ║"
اطبع "╚══════════════════════════════════════════════════╝"
اطبع ""

# ─── أدوات مساعدة ───
دالة خط(عنوان) {
  اطبع ""
  اطبع "─── " + عنوان + " ──────────────────────"
}

دالة حجم_مقروء(بايت) {
  اذا بايت < 1024 { ارجع نص(بايت) + " B" }
  اذا بايت < 1024 * 1024 { ارجع نص(بايت / 1024) + " KB" }
  ارجع نص(بايت / 1024 / 1024) + " MB"
}

دالة علامة(شرط) {
  ارجع اذا شرط { "✓" } والا { "✗" }
}

# ─── 1. البيئة ───
خط("البيئة")
متغير بيئة = apk_بيئة()
اطبع "  apktool  " + اسم_الملف(بيئة.apktool_jar)
اطبع "  java     " + اسم_الملف(بيئة.java)
اطبع "  aapt2    " + اسم_الملف(بيئة.aapt2)
اطبع "  signer   " + اسم_الملف(بيئة.signer_jar)
اطبع "  keystore " + علامة(موجود(بيئة.keystore))

# ─── 2. ابحث عن APK ───
خط("البحث عن APK")
متغير مجلد = ضم(مسار_الرئيسية()، "عصام القاضي/apps_patched")
متغير ملفات = اقرأ_مجلد(مجلد)

متغير apk_path = عدم
لكل ملف في ملفات {
  اذا امتداد(ملف) == ".apk" {
    متغير مسار = ضم(مجلد، ملف)
    اذا موجود(مسار) {
      apk_path = مسار
      اكسر
    }
  }
}

اذا apk_path == عدم {
  اطبع "  لا يوجد APK للتجريب"
  ارجع
}

اطبع "  الملف: " + اسم_الملف(apk_path)
اطبع "  الحجم: " + حجم_مقروء(تفاصيل(apk_path).حجم)

# ─── 3. معلومات APK ───
خط("تحليل APK")
متغير info = apk_معلومات(apk_path)
اطبع "  الحزمة:  " + (اذا info.حزمة { info.حزمة } والا { "غير معروف" })
اطبع "  الإصدار: " + (اذا info.إصدار { info.إصدار } والا { "—" })

# ─── 4. تفكيك APK ───
خط("فك APK")
متغير مجلد_فك = ضم("/tmp"، "narmin_demo_" + نص(تفاصيل(apk_path).حجم))
اطبع "  ▶ يستغرق بضع ثواني..."
متغير فك_نتيجة = apk_فك(apk_path، مجلد_فك)
اطبع "  " + علامة(فك_نتيجة.نجح) + " فُك إلى: " + اسم_الملف(مجلد_فك)

# ─── 5. افحص الملفات المفكوكة ───
خط("بنية APK المفكوكة")
متغير محتويات = اقرأ_مجلد(مجلد_فك)
اطبع "  عدد العناصر: " + نص(طول(محتويات))
لكل عنصر في محتويات {
  متغير مسار_عنصر = ضم(مجلد_فك، عنصر)
  اذا نوع(تفاصيل(مسار_عنصر)) == "كائن" {
    اذا تفاصيل(مسار_عنصر).نوع == "مجلد" {
      اطبع "    📁 " + عنصر
    } والا {
      اطبع "    📄 " + عنصر
    }
  }
}

# ─── 6. اقرأ AndroidManifest ───
خط("AndroidManifest.xml")
متغير manifest = ضم(مجلد_فك، "AndroidManifest.xml")
اذا موجود(manifest) {
  متغير محتوى = اقرأ(manifest)
  اطبع "  الحجم: " + حجم_مقروء(طول(محتوى))
  اطبع "  أول سطر: " + جزء(محتوى، 0، 60) + "..."
} والا {
  اطبع "  غير موجود"
}

# ─── 7. اكتب تقرير JSON ───
خط("حفظ تقرير JSON")
متغير تقرير = {
  الملف: اسم_الملف(apk_path)،
  الحجم: تفاصيل(apk_path).حجم،
  الحزمة: info.حزمة،
  الإصدار: info.إصدار،
  مجلد_الفك: مجلد_فك،
  عدد_العناصر: طول(محتويات)،
  وقت: معلومات().وقت
}
متغير مسار_تقرير = ضم("/tmp"، "narmin_report.json")
اكتب_json(مسار_تقرير، تقرير)
اطبع "  " + علامة(موجود(مسار_تقرير)) + " " + مسار_تقرير

# ─── 8. تنظيف ───
خط("تنظيف")
احذف(مجلد_فك)
اطبع "  " + علامة(ليس موجود(مجلد_فك)) + " حُذف مجلد الفك"

اطبع ""
اطبع "═══════════════════════════════════════════════════"
اطبع "  ✓ اكتمل العرض — نارمين تعمل فعلاً"
اطبع "═══════════════════════════════════════════════════"
