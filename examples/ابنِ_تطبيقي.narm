# بناء تطبيق نارمين

متغير اسم = "MyFirstApp"
متغير مسار = ضم(مسار_الرئيسية()، "DEV/apps_building"، اسم)

اطبع "═══════════════════════════════════"
اطبع "  بناء: " + اسم
اطبع "═══════════════════════════════════"
اطبع ""

متغير نتيجة = android_بناء(مسار)

اطبع ""
اطبع "═══════════════════════════════════"
اذا نتيجة.نجح {
  اطبع "  ✓ نجح البناء"
  اطبع "  APK: " + نتيجة.apk
} والا {
  اطبع "  ✗ فشل (كود " + نص(نتيجة.كود) + ")"
  اطبع ""
  اطبع "  آخر سطور الخرج:"
  اطبع نتيجة.خرج
  اطبع ""
  اطبع "  آخر الأخطاء:"
  اطبع نتيجة.خطأ
}
اطبع "═══════════════════════════════════"
