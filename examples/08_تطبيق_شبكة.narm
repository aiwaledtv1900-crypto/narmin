# مثال 8: تطبيق يجلب من الإنترنت
# شغّل: narm run examples/08_تطبيق_شبكة.narm

#@النمط: ازرق داكن
#@الزر: ذهبي

صلاحية "انترنت"

شاشة "الشبكة"
  الشريط_العلوي ( لون "ازرق داكن" حجم 70 نص "HTTP" )

  كتابة "اضغط الزر لجلب البيانات من الإنترنت"

  مسافة 16

  زر "🌐 اجلب" ( لون "ذهبي" حواف "دايري" العرض "كامل" ) عند_الضغط
    متغير رد = جلب("https://api.github.com/zen")
    اذا رد["نجح"]
      حوار "الرد من GitHub" رد["جسم"]
    والا
      حوار "خطأ" رد["خطأ"]
    نهاية
  نهاية
نهاية
