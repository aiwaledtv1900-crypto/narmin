# مثال 7: تطبيق مذكرة كامل
# شغّل: narm run examples/07_تطبيق_مذكرة.narm

#@النمط: كريمي
#@الزر: بنفسجي عميق

صلاحية "انترنت"

شاشة "مذكرتي"
  الشريط_العلوي ( لون "بنفسجي عميق" حجم 70 نص "مذكراتي" )

  محفوظ مذكرات = []

  حقل "اكتب مذكرة..." كـ جديدة ( حواف "متوسط" العرض "كامل" )

  مسافة 8

  زر "➕ أضف" ( لون "بنفسجي عميق" حواف "دايري" العرض "كامل" ) عند_الضغط
    اذا جديدة != ""
      أضف(مذكرات، جديدة)
    نهاية
  نهاية

  مسافة 16

  كتابة "📚 عدد المذكرات: " + نص(طول(مذكرات))

  مسافة 8

  قائمة مذكرات
    بطاقة "📝 مذكرة" ( لون "لبني" حواف "متوسط" )
      كتابة العنصر
      مسافة 4
      زر "🗑 احذف" ( لون "احمر" حواف "بيضاوي" ) عند_الضغط
        احذف_من(مذكرات، العنصر)
      نهاية
    نهاية
  نهاية
نهاية
