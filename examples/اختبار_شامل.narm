# ═══════════════════════════════════════════════
#  اختبار شامل — كل ميزات نارمين في ملف واحد
# ═══════════════════════════════════════════════

# ─── 1) أيقونة مخصصة ───
ايقونة ( نص "اختبار" لون "بنفسجي عميق" شكل "دايري" )

# ─── 2) صلاحيات ───
صلاحية "انترنت"
صلاحية "إشعارات"
صلاحية "اهتزاز"

# ─── 3) مكتبات ───
مكتبة "com.google.code.gson:gson:2.10.1"

# ─── 4) أنماط نص مخصصة ───
نص_عنوان "بنفسجي عميق"
نص_عادي "فحمي_فاتح"
زر_رئيسي "احمر زاهي"
زر_ثانوي "ازرق"
زر_تحذير "برتقالي"

# ─── 5) الشاشة ───
شاشة "اختبار كل الميزات"
  # شريط علوي مخصص
  الشريط_العلوي ( لون "بنفسجي عميق" حجم 70 نص "اختبار نارمين" )

  # ─── متغيرات محفوظة ───
  محفوظ مهام = []
  محفوظ عداد = 0
  محفوظ اسم_مستخدم = "ضيف"

  # ─── حقل مع ربط ───
  حقل "اكتب اسمك..." كـ اسم_مستخدم ( لون 'نص_عنوان' حواف "متوسط" العرض "كامل" )

  مسافة 8

  # ─── حقل للمهام ───
  حقل "اكتب مهمة جديدة..." كـ جديدة ( حواف "متوسط" العرض "كامل" )

  مسافة 8

  # ─── زر مع جرب/التقط ───
  زر "➕ أضف مهمة" ( لون 'زر_رئيسي' حواف "دايري" العرض "كامل" الطول 56 ) عند_الضغط
    جرب
      اذا جديدة != ""
        أضف(مهام، جديدة)
        عداد = عداد + 1
      والا
        ارم "الحقل فارغ"
      نهاية
    التقط e
      تنبيه "خطأ" 
    نهاية
  نهاية

  مسافة 16

  # ─── عرض ديناميكي ───
  كتابة "👤 " + اسم_مستخدم ( لون 'نص_عنوان' )
  كتابة "📋 المهام: " + نص(طول(مهام)) ( لون 'نص_عادي' )

  مسافة 8

  # ─── قائمة ديناميكية ───
  قائمة مهام
    بطاقة "مهمة" ( لون "لبني" حواف "متوسط" )
      كتابة العنصر ( لون 'نص_عادي' )
      مسافة 4
      صف
        زر "🗑 احذف" ( لون 'زر_تحذير' حواف "بيضاوي" ) عند_الضغط
          احذف_من(مهام، العنصر)
          عداد = عداد - 1
        نهاية
      نهاية
    نهاية
  نهاية

  مسافة 16

  # ─── جلب من الإنترنت ───
  زر "🌐 اجلب من GitHub" ( لون 'زر_ثانوي' حواف "دايري" العرض "كامل" ) عند_الضغط
    جرب
      متغير رد = جلب("https://api.github.com/zen")
      اذا رد["نجح"]
        حوار "من GitHub" رد["جسم"]
      والا
        حوار "خطأ الشبكة" رد["خطأ"]
      نهاية
    التقط e
      تنبيه "خطأ" 
    نهاية
  نهاية

  مسافة 8

  # ─── إشعار Android ───
  زر "🔔 أرسل إشعاراً" ( لون "ذهبي" حواف "دايري" العرض "كامل" ) عند_الضغط
    أرسل_تنبيه "اختبار نارمين" "كل الميزات تعمل!"
  نهاية

  مسافة 8

  # ─── تنبيه Toast ───
  زر "💬 تنبيه سريع" ( لون "بنفسجي" حواف "بيضاوي" العرض "كامل" ) عند_الضغط
    تنبيه "نارمين تعمل"
  نهاية

  مسافة 16

  # ─── عرض الحالة ───
  كتابة "─────────────────" ( لون "رمادي" )
  كتابة "✓ 15 ميزة تعمل" ( لون 'زر_رئيسي' )
نهاية
